---
import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { GRANTS, TALKS } from "@consts";

const title = "Activities";
const description = "Conference presentations and research grants.";
---

<PageLayout {title} {description}>
  <Container>
    <div class="space-y-10">
      <div>
        <BackToPrev href="/">Home</BackToPrev>
      </div>
      <h1 class="font-semibold text-black dark:text-white">Activities</h1>
      <section class="space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Conference presentations</h2>
        <ul class="space-y-3">
          {TALKS.map(talk => (
            <li>
              <div>{talk.TITLE}</div>
              <div class="text-sm opacity-75">{talk.DESCRIPTION}</div>
            </li>
          ))}
        </ul>
      </section>
      <section class="space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Grants</h2>
        <ul class="space-y-3">
          {GRANTS.map(grant => (
            <li>
              <div>{grant.TITLE}</div>
              <div class="text-sm opacity-75">{grant.DESCRIPTION}</div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
