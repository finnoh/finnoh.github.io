---
import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";

const title = "Teaching";
const description = "Teaching and supervision in machine learning, natural language processing, text analytics, and AI agents.";
---

<PageLayout {title} {description}>
  <Container>
    <div class="space-y-10">
      <div>
        <BackToPrev href="/">Home</BackToPrev>
      </div>
      <h1 class="font-semibold text-black dark:text-white">Teaching</h1>
      <section class="space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Erasmus School of Economics</h2>
        <p>Teaching Assistant, Supervisor, and Instructor · 2024–Present</p>
        <p>Teaching Assistant in Text Analytics (2025); Bachelor’s and Master’s thesis supervision, including one national thesis award (2025); and instructor for the UNICEF case study (teaching evaluation: 4.84/5, N = 25; 2026–2027).</p>
      </section>
      <section class="space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Tinbergen Institute</h2>
        <p>Instructor · 2023–Present</p>
        <p>Natural Language Processing and Machine Learning 2 (2024); Skills Workshop: Research Idea Generation “AI” (2025–2027).</p>
      </section>
      <section class="space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Tinbergen Institute Summer School for Academics and Professionals</h2>
        <p>Instructor · 2026–Present</p>
        <p>Developed and taught AI Agents in Economics and Business Research (two-day course; 2026–2027).</p>
      </section>
    </div>
  </Container>
</PageLayout>
