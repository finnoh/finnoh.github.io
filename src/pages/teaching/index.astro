---
import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";

const title = "Teaching";
const description = "Teaching and supervision in machine learning, natural language processing, and text analytics.";
---

<PageLayout {title} {description}>
  <Container>
    <div class="space-y-10">
      <div>
        <BackToPrev href="/">Home</BackToPrev>
      </div>
      <h1 class="font-semibold text-black dark:text-white">Teaching</h1>
      <section class="space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Erasmus School of Economics</h2>
        <p>Teaching Assistant / Supervisor · 2024–Present</p>
        <p>Text Analytics; UNICEF case study (teaching evaluation: 4.84/5, N = 25); and thesis supervision.</p>
      </section>
      <section class="space-y-4">
        <h2 class="font-semibold text-black dark:text-white">Tinbergen Institute</h2>
        <p>Instructor · 2023–Present</p>
        <p>AI Agents in Economics and Business Research (two-day course), Natural Language Processing, and Machine Learning 2.</p>
      </section>
    </div>
  </Container>
</PageLayout>
