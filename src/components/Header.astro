---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <Link href="/" underline={false}><div class="font-semibold">{SITE.NAME}</div></Link>
      <nav class="flex flex-wrap gap-1" aria-label="Primary navigation">
        <Link href="/blog">research</Link><span>/</span><Link href="/teaching">teaching</Link><span>/</span><Link href="/projects">conference presentations</Link>
      </nav>
    </div>
  </Container>
</header>
