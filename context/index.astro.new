---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ContactLinks from "@components/ContactLinks.astro";
import Link from "@components/Link.astro";
import { GRANTS, HOME, TALKS } from "@consts";

const researchPipeline = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="space-y-16">
      <div>
        <h1 class="animate text-[21px] font-semibold text-black dark:text-white">Finn-Ole Höner</h1>
        <p class="animate mt-2 text-sm">PhD Researcher in Quantitative Marketing</p>
        <p class="animate text-sm">Erasmus School of Economics · Rotterdam, Netherlands</p>
        <ContactLinks class="animate mt-3 flex flex-wrap gap-x-3" />
      </div>
      <article class="space-y-4">
        <p class="animate">I develop LLM-based methods for market research, with a focus on generative embeddings, synthetic data, and multi-agent systems.</p>
        <p class="animate">My technical work spans transformer models, fine-tuning, and GPU-based training with PyTorch, CUDA, and SLURM.</p>
        <p class="animate">I hold a Research Master in Business Data Science from Tinbergen Institute and an M.Sc. in Data Science in Business and Economics from the University of Tübingen.</p>
      </article>
    </section>
    <div class="mt-16 space-y-16">
      <section class="animate space-y-4">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">Research</h2>
          <Link href="/blog">View all research</Link>
        </div>
        <ul class="space-y-3">
          {researchPipeline.map(paper => (
            <li>
              <Link href={`/blog/${paper.id}`}>{paper.data.title}</Link>
              <div class="text-sm opacity-75">{paper.data.description}</div>
            </li>
          ))}
        </ul>
      </section>
      <section class="animate space-y-4">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">Teaching</h2>
          <Link href="/teaching">View teaching</Link>
        </div>
        <ul class="space-y-3">
          <li><div>Erasmus School of Economics</div><div class="text-sm opacity-75">Teaching Assistant / Supervisor · 2024–Present · Text Analytics and thesis supervision.</div></li>
          <li><div>Tinbergen Institute</div><div class="text-sm opacity-75">Instructor · 2023–Present · AI Agents in Economics and Business Research, NLP, and Machine Learning 2.</div></li>
        </ul>
      </section>
      <section class="animate space-y-4">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">Activities</h2>
          <Link href="/activities">View activities</Link>
        </div>
        <ul class="space-y-3">
          <li><div>{TALKS[0].TITLE}</div><div class="text-sm opacity-75">{TALKS[0].DESCRIPTION}</div></li>
          <li><div>{GRANTS[0].TITLE}</div><div class="text-sm opacity-75">{GRANTS[0].DESCRIPTION}</div></li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
